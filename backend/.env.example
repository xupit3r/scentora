# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# For docker-compose setup, use port 5435 (mapped from container's 5432)
DATABASE_URL=postgres://admin:password@localhost:5435/scentora?sslmode=disable
DB_HOST=localhost
DB_PORT=5435
DB_USER=admin
DB_PASSWORD=password
DB_NAME=scentora
DB_SSLMODE=disable

# JWT Configuration
# IMPORTANT: Generate a secure random secret for production!
# Use: openssl rand -hex 32
JWT_SECRET=5YiNkvm1lLgigIXCkZrZVFbRP8UMeb42YfWKAvLva3E=
JWT_ACCESS_EXPIRES_IN=7d

# Master Password (required)
# Single shared password for all users
MASTER_PASSWORD=CHANGE_ME

# CORS Configuration
# Add your frontend URL here (comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
