generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String    @unique @db.VarChar(255)
  username             String    @db.VarChar(100)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  validateRecipeVolumes Boolean  @default(false) @map("validate_recipe_volumes")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @default(now()) @map("updated_at")

  refreshTokens        RefreshToken[]
  invitationsCreated   Invitation[]       @relation("InvitationCreator")
  invitationsUsed      Invitation[]       @relation("InvitationUser")
  accords              Accord[]
  recipes              Recipe[]
  recipeCollections    RecipeCollection[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Invitation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique @db.VarChar(255)
  email     String?   @db.VarChar(255)
  createdBy String    @map("created_by") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  usedAt    DateTime? @map("used_at")
  usedBy    String?   @map("used_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  creator User  @relation("InvitationCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  usedByUser User? @relation("InvitationUser", fields: [usedBy], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([createdBy])
  @@map("invitations")
}

model Accord {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  name               String    @db.VarChar(255)
  pyramidPosition    String    @map("pyramid_position") @db.VarChar(10)
  volumeMl           Decimal   @map("volume_ml") @db.Decimal(10, 2)
  volumeDrops        Int?      @map("volume_drops")
  supplier           String?   @db.VarChar(255)
  purchaseDate       DateTime? @map("purchase_date") @db.Date
  dilutionPercentage Decimal?  @map("dilution_percentage") @db.Decimal(5, 2)
  notes              String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @map("updated_at")

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags AccordTag[]
  recipeIngredients RecipeIngredient[]

  @@unique([userId, name, pyramidPosition])
  @@index([userId])
  @@index([pyramidPosition])
  @@index([createdAt(sort: Desc)])
  @@map("accords")
}

model AccordTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accordId  String   @map("accord_id") @db.Uuid
  tag       String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  accord Accord @relation(fields: [accordId], references: [id], onDelete: Cascade)

  @@unique([accordId, tag])
  @@index([accordId])
  @@index([tag])
  @@map("accord_tags")
}

model PredefinedTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category  String   @db.VarChar(50)
  tag       String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("predefined_tags")
}

model Recipe {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  targetVolumeMl  Decimal   @map("target_volume_ml") @db.Decimal(10, 2)
  status          String    @default("draft") @db.VarChar(20)
  activeVersionId String?   @map("active_version_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeVersion  RecipeVersion?    @relation("ActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  versions       RecipeVersion[]   @relation("RecipeVersions")
  notes          RecipeNote[]
  tags           RecipeTag[]
  collectionMembers RecipeCollectionMember[]

  @@unique([userId, name])
  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("recipes")
}

model RecipeVersion {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId      String   @map("recipe_id") @db.Uuid
  versionNumber Int      @map("version_number")
  name          String   @db.VarChar(100)
  notes         String?  @db.Text
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  recipe      Recipe             @relation("RecipeVersions", fields: [recipeId], references: [id], onDelete: Cascade)
  activeFor   Recipe[]           @relation("ActiveVersion")
  ingredients RecipeIngredient[]
  recipeNotes RecipeNote[]

  @@unique([recipeId, versionNumber])
  @@index([recipeId])
  @@index([isActive])
  @@map("recipe_versions")
}

model RecipeIngredient {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId     String   @map("version_id") @db.Uuid
  accordId      String   @map("accord_id") @db.Uuid
  quantityMl    Decimal  @map("quantity_ml") @db.Decimal(10, 2)
  quantityDrops Int?     @map("quantity_drops")
  percentage    Decimal? @db.Decimal(5, 2)
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  version RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  accord  Accord        @relation(fields: [accordId], references: [id], onDelete: Restrict)

  @@unique([versionId, accordId])
  @@index([versionId])
  @@index([accordId])
  @@map("recipe_ingredients")
}

model RecipeNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  versionId String?  @map("version_id") @db.Uuid
  content   String   @db.Text
  noteType  String   @default("general") @map("note_type") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  recipe  Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  version RecipeVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([versionId])
  @@map("recipe_notes")
}

model RecipeTag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  tag       String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tag])
  @@index([recipeId])
  @@index([tag])
  @@map("recipe_tags")
}

model RecipeCollection {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  user    User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  members RecipeCollectionMember[]

  @@unique([userId, name])
  @@index([userId])
  @@map("recipe_collections")
}

model RecipeCollectionMember {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  recipeId     String   @map("recipe_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at")

  collection RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe     Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([collectionId, recipeId])
  @@index([collectionId])
  @@index([recipeId])
  @@map("recipe_collection_members")
}
